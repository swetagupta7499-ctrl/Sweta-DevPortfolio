<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500" font-family="Courier New, Consolas, monospace" xmlns:c2pa="http://c2pa.org/manifest">
<style>
.star{animation:tw 2.4s ease-in-out infinite}
@keyframes tw{0%,100%{opacity:.15}50%{opacity:1}}
.hillA{animation:scrollA 14s linear infinite}
.hillB{animation:scrollA 7s linear infinite}
@keyframes scrollA{from{transform:translateX(0)}to{transform:translateX(-800px)}}
.cloud{animation:scrollC 26s linear infinite}
.cloud2{animation:scrollC 40s linear infinite}
@keyframes scrollC{from{transform:translateX(0)}to{transform:translateX(-800px)}}
.ground{animation:scrollG 1.2s linear infinite}
@keyframes scrollG{from{transform:translateX(0)}to{transform:translateX(-800px)}}
.hero{animation:jump 4s infinite}
@keyframes jump{
 0%,62%{transform:translateY(0);animation-timing-function:cubic-bezier(.2,.7,.4,1)}
 74%{transform:translateY(-120px);animation-timing-function:cubic-bezier(.6,0,.8,.4)}
 86%,100%{transform:translateY(0)}
}
.legA{animation:legA .36s steps(1) infinite}
.legB{animation:legB .36s steps(1) infinite}
@keyframes legA{0%{opacity:1}50%{opacity:0}}
@keyframes legB{0%{opacity:0}50%{opacity:1}}
.bob{animation:bob .36s steps(1) infinite}
@keyframes bob{0%{transform:translateY(0)}50%{transform:translateY(-3px)}}
.bug{animation:move 4s linear infinite}
@keyframes move{from{transform:translateX(0)}to{transform:translateX(-1000px)}}
.coin{animation:spin .9s linear infinite;transform-box:fill-box;transform-origin:center}
@keyframes spin{0%,100%{transform:scaleX(1)}50%{transform:scaleX(.15)}}
.blink{animation:blink 1s steps(1) infinite}
@keyframes blink{0%{opacity:1}50%{opacity:0}}
</style>
<defs>
<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#050b16"/><stop offset="0.6" stop-color="#0d2142"/><stop offset="1" stop-color="#1e4fa8"/></linearGradient>
<clipPath id="round"><rect width="800" height="500" rx="18"/></clipPath>
</defs>
<g clip-path="url(#round)">
<rect width="800" height="500" fill="url(#sky)"/>
